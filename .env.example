# DeepSeek（OpenAI 兼容接口）配置
# 复制为 .env 并填写，或直接设置环境变量

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-你的apikey
LLM_MODEL=deepseek-v4-flash

# scLinformer 模型运行（可选）
# MODEL_EPOCHS=1
# MODEL_BATCH_SIZE=64   # 留空则按显存+数据量自动判断

# 跨模态模型源码目录（可选；缺省按项目根目录的 ../model/ 推断）
# SCBUTTERFLY_DIR=D:\code\RNAgent\model\scButterfly\scButterfly   # 指向包目录（含 train_model.py）
# SCROSSTALK_DIR=D:\code\RNAgent\model\scCrossTalk-main           # 指向仓库根（含 scCrossTalk/ 与 gene_vocab.json）

# 跨模态模型参数覆盖（按模型前缀隔离，互不影响）
# SCBUTTERFLY_EPOCHS=100
# SCBUTTERFLY_TRANSLATOR_EPOCHS=200
# SCROSSTALK_EPOCHS=100
# SCROSSTALK_TRANSLATOR_EPOCHS=200

# execute_code Docker 沙箱（可选；Docker 不可用时 execute_code 拒绝执行）
# SANDBOX_IMAGE=rna-sandbox:latest   # 首次运行按 docker/sandbox.Dockerfile 自动构建
# SANDBOX_TIMEOUT=300                # 沙箱执行超时（秒），超时强杀容器
# SANDBOX_MEM_MB=4096                # 沙箱内存上限（MB）
# SANDBOX_CPUS=2                     # 沙箱 CPU 限额
